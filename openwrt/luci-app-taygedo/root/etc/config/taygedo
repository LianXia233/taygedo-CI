config taygedo 'main'
	# 服务级配置（UCI 只管服务本身）
	# 默认启用：本包为 LuCI 集成服务，安装后由 post-install 自动 enable + start。
	# 如需停用：uci set taygedo.main.enabled=0 && uci commit taygedo
	option enabled '1'
	option port '8787'
	option data_dir '/etc/taygedo'

	# ---- 鉴权（openwrt 构建产物）----
	# 该二进制不含 WebUI，LuCI 是唯一入口。后端只监听回环，由 rpcd/ucode 插件在
	# 服务端以已认证的 LuCI 会话身份调用；ucode 把 ubus_rpc_session 作为
	# X-TGD-Luci-Session 透传。鉴权边界是 rpcd ACL：回环路径下后端只校验会话号
	# 形态（再嵌套 ubus 会因 uloop 死锁），非回环来源才触发 ubus 二次校验。
	# 本服务不签发也不校验任何自有凭据。
	option luci_session_check '1'

	# 业务配置（默认签到时间/金币任务/云时长/分享平台）统一在 config.json 中管理，
	# LuCI 页面经 rpcd 通道读写 /api/config。

	# 受信来源网段（逗号分隔 CIDR）。本机回环始终受信，不受此配置影响。
	# 留空则回落到内置默认：RFC1918 三段 + loopback + IPv6 ULA/链路本地。
	#
	# 注意：这里**没有** crypto_policy。该形态不挂应用层加密信封中间件
	# （没有握手端点、没有浏览器侧消费者），配置一个不生效的加密策略属于
	# 死配置，已从 UCI 与 LuCI 设置面板一并移除。
	option lan_cidrs ''

	# ---- 配置文件静态加密（XChaCha20-Poly1305 + HKDF-SHA256）----
	# /etc/taygedo 下的 accounts.json / config.json / state.json / keyring.json
	# 一律以密文落盘，主密钥位于 /etc/taygedo/keys/master.key（root:root 0600）。
	# OpenWrt 没有 systemd 凭据 / TPM，也不使用 Windows DPAPI，因此密钥保护
	# 依赖文件系统权限本身：**请确保 /etc/taygedo 与 keys/ 均为 0700 root:root**。
	#
	# 密钥丢失 = 既有密文永久不可解（无法恢复，只能删库重建）。
	# 备份时请把 keys/master.key 一并离线保管，且不要与密文放在同一介质上。
	# 轮换密钥：/usr/bin/taygedo-rs --rotate-storage-key
