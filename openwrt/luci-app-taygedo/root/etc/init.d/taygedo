#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/taygedo-rs

start_service() {
    local enabled port data_dir
    local crypto_policy lan_cidrs luci_session_check
    config_load 'taygedo'
    config_get_bool enabled 'main' 'enabled' 0
    [ "$enabled" -eq 0 ] && return 0

    config_get port 'main' 'port' '8787'
    config_get data_dir 'main' 'data_dir' '/etc/taygedo'
    config_get crypto_policy 'main' 'crypto_policy' 'auto'
    config_get lan_cidrs 'main' 'lan_cidrs' ''
    config_get_bool luci_session_check 'main' 'luci_session_check' 1

    [ -d "$data_dir" ] || mkdir -p "$data_dir"
    # 密钥目录权限：长期身份私钥 + 配置加密主密钥落在此目录，必须仅 root 可读。
    # overlayfs 上首次创建时补设 700，避免升级/重建后继承宽松权限。
    # （二进制自身也会在创建 keys/ 时设 0700，这里是升级路径的兜底。）
    chmod 700 "$data_dir" 2>/dev/null
    if [ -d "$data_dir/keys" ]; then
        chmod 700 "$data_dir/keys" 2>/dev/null
        chmod 600 "$data_dir/keys"/* 2>/dev/null
    fi

    # 运行版本与访问通道（OpenWrt 集成模式）：
    # - 无内置 WebUI、无浏览器侧加密前端。唯一入口是 LuCI 菜单。
    # - 数据由 rpcd/ucode 插件（/usr/share/rpcd/ucode/luci.taygedo）在服务端
    #   以已认证的 LuCI 会话身份调用本机回环接口取得，浏览器不直连本端口。
    #   因此这里**只监听 127.0.0.1**，不对 LAN 暴露。
    # - 鉴权交给 OpenWrt：ucode 把 ubus_rpc_session 作为 X-TGD-Luci-Session
    #   透传给后端，后端调用本机 ubus `session get` 判定有效性；本服务不签发
    #   任何自有凭据。
    # - luci_session_check=0 仅用于排障：退回"仅受信来源（回环/内网白名单）"，
    #   请勿长期开启。
    #
    # 职责划分：
    # - UCI 只管「服务级」配置：启停 / 端口 / 数据目录 / 鉴权模式 /
    #   加密策略与内网网段；
    # - 「业务级」配置（默认签到时间 / 金币任务 / 云时长 / 分享平台）统一由
    #   config.json 管理，LuCI 页面经 rpcd 通道读写 /api/config。

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param env \
        TAYGEDO_EDITION="openwrt" \
        TAYGEDO_LISTEN="127.0.0.1:${port}" \
        TAYGEDO_DATA_DIR="$data_dir" \
        TAYGEDO_LUCI_SESSION_CHECK="$luci_session_check" \
        TAYGEDO_CRYPTO_POLICY="$crypto_policy"
    # 空值不传，交由后端回落到内置默认网段（避免传空串把白名单清空）
    [ -n "$lan_cidrs" ] && procd_append_param env TAYGEDO_LAN_CIDRS="$lan_cidrs"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger 'taygedo'
}
