#!/bin/sh /etc/rc.common

START=90
STOP=10
USE_PROCD=1

PROG=/usr/bin/taygedo-rs

start_service() {
    local enabled port data_dir web_password default_schedule
    config_load 'taygedo'
    config_get_bool enabled 'main' 'enabled' 0
    [ "$enabled" -eq 0 ] && return 0

    config_get port 'main' 'port' '8787'
    config_get data_dir 'main' 'data_dir' '/etc/taygedo'
    config_get web_password 'main' 'web_password' ''
    config_get default_schedule 'main' 'default_schedule' '06:10'

    [ -d "$data_dir" ] || mkdir -p "$data_dir"

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param env TAYGEDO_LISTEN "0.0.0.0:${port}"
    procd_set_param env TAYGEDO_DATA_DIR "$data_dir"
    [ -n "$web_password" ] && procd_set_param env TAYGEDO_WEB_PASSWORD "$web_password"
    procd_set_param env TAYGEDO_DEFAULT_SCHEDULE "$default_schedule"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger 'taygedo'
}
