{
	"luci-app-taygedo": {
		"description": "Grant access to Taygedo auto attendance",
		"read": {
			"ubus": {
				"service": [ "list" ]
			},
			"uci": [ "taygedo" ],
			"file": {
				"/etc/config/taygedo": [ "read" ]
			}
		},
		"write": {
			"uci": [ "taygedo" ],
			"file": {
				"/etc/config/taygedo": [ "write" ]
			},
			"ubus": {
				"service": [ "restart", "reload" ]
			}
		}
	}
}
