'use strict';

// LuCI ↔ 塔吉多后端 的 rpcd 内部通道。
//
// 设计约束（与仓库其余部分一致，刻意保持最小实现，不引入新框架）：
//   - 浏览器不直连后端端口：本插件在 rpcd 服务端（root 身份）用 curl 调
//     本机回环 http://127.0.0.1:<uci port>。
//   - 身份由 OpenWrt 提供：前端把 L.env.sessionid（ubus_rpc_session）作为
//     sid 参数传入，本插件原样透传为 X-TGD-Luci-Session 头；后端再调用
//     `ubus call session get` 校验。本插件不签发、不缓存任何凭据。
//   - 方法白名单：每个 ubus 方法对应唯一固定的 HTTP 方法与路径，参数只允许
//     出现在 body 或严格校验过的 id/limit 上，避免把请求参数拼进 shell。
//   - ACL 粒度为单个方法（见 acl.d/luci-app-taygedo.json），不使用"一个通吃
//     的 request 方法"，避免一次授权放行全部业务写操作。

import { popen, readfile, writefile } from 'fs';

const FALLBACK_PORT = 8787;
const CURL_TIMEOUT = 15;

// 读取 UCI 配置的端口。非法值回落到 8787（与 init.d 默认一致）。
function backend_port() {
	let h = popen('uci -q get taygedo.main.port', 'r');
	let v = h ? trim(h.read('all')) : '';
	if (h)
		h.close();
	let n = +v;
	return (n > 0 && n < 65536) ? n : FALLBACK_PORT;
}

// LuCI 会话号白名单校验：只允许 ubus_rpc_session 的字符集。
// sid 会进入 shell 命令行，必须严格校验，不能直接拼接收外部输入。
function valid_sid(sid) {
	if (type(sid) != 'string')
		return false;
	let s = trim(sid);
	if (length(s) < 1 || length(s) > 128)
		return false;
	return match(s, /^[A-Za-z0-9_.:-]+$/) ? true : false;
}

// 账号 id 白名单校验（同样是拼进 URL path 的外部输入）。
function valid_id(id) {
	if (type(id) != 'string')
		return false;
	return match(id, /^[A-Za-z0-9_-]{1,64}$/) ? true : false;
}

function fail(http, msg) {
	return { ok: false, http: http, error: msg };
}

// 统一的内部调用：固定方法+路径，body 走临时文件（避免 shell 引号与注入），
// 只把 HTTP 状态码留在 stdout，响应体写入文件后读取。
function call(req, opt) {
	let args = req.args ? req.args : {};
	let sid = args.sid;
	let body = opt.body ? opt.body(args) : null;
	let path = opt.path(args);

	if (path == null)
		return fail(400, 'bad arguments');

	let need_auth = opt.auth != false;
	if (need_auth && !valid_sid(sid))
		return fail(401, 'missing LuCI session');

	let mktmp = popen('mktemp -d /tmp/tgd.rpcd.XXXXXX', 'r');
	let dir = mktmp ? trim(mktmp.read('all')) : '';
	if (mktmp)
		mktmp.close();
	if (length(dir) < 1)
		return fail(500, 'tmpdir create failed');

	let cmd = 'curl -sS --max-time ' + CURL_TIMEOUT + ' --noproxy \'*\''
		+ ' -o \'' + dir + '/out\' -w \'%{http_code}\''
		+ ' -X ' + opt.method
		+ ' -H \'Accept: application/json\'';

	if (need_auth)
		cmd += ' -H \'X-TGD-Luci-Session: ' + trim(sid) + '\'';

	if (body != null) {
		writefile(dir + '/req', json(body));
		cmd += ' -H \'Content-Type: application/json\''
			+ ' --data-binary @\'' + dir + '/req\'';
	}

	cmd += ' \'http://127.0.0.1:' + backend_port() + path + '\'';

	let h = popen(cmd, 'r');
	let code = h ? trim(h.read('all')) : '0';
	if (h)
		h.close();

	let raw = readfile(dir + '/out');
	let clean = popen('rm -rf \'' + dir + '\'', 'r');
	if (clean)
		clean.close();

	let status = +code;
	if (!(status > 0))
		return fail(503, 'backend unreachable');

	let data = null;
	if (raw != null && length(trim(raw)) > 0) {
		try {
			data = json(raw);
		} catch (e) {
			data = null;
		}
	}

	if (status >= 200 && status < 300)
		return { ok: true, http: status, data: data };

	let msg = 'backend error';
	if (type(data) == 'object' && data != null && type(data.error) == 'string')
		msg = data.error;
	else if (type(data) == 'object' && data != null && type(data.message) == 'string')
		msg = data.message;

	return { ok: false, http: status, error: msg, data: data };
}

// 业务方法。全部经后端 /api/*，不含任何 WebUI 专属接口。
return {
	meta: function(req) {
		return call(req, {
			method: 'GET',
			path: function() { return '/api/meta'; },
			auth: false
		});
	},

	config_get: function(req) {
		return call(req, {
			method: 'GET',
			path: function() { return '/api/config'; }
		});
	},

	config_set: function(req) {
		return call(req, {
			method: 'POST',
			path: function() { return '/api/config'; },
			body: function(a) { return a.body != null ? a.body : {}; }
		});
	},

	accounts_list: function(req) {
		return call(req, {
			method: 'GET',
			path: function() { return '/api/accounts'; }
		});
	},

	account_add: function(req) {
		return call(req, {
			method: 'POST',
			path: function() { return '/api/accounts'; },
			body: function(a) { return a.body != null ? a.body : {}; }
		});
	},

	account_delete: function(req) {
		return call(req, {
			method: 'DELETE',
			path: function(a) {
				return valid_id(a.id) ? '/api/accounts/' + a.id : null;
			}
		});
	},

	signin: function(req) {
		return call(req, {
			method: 'POST',
			path: function(a) {
				return valid_id(a.id) ? '/api/accounts/' + a.id + '/signin' : null;
			},
			body: function() { return { force: true }; }
		});
	},

	schedule_set: function(req) {
		return call(req, {
			method: 'POST',
			path: function(a) {
				return valid_id(a.id) ? '/api/accounts/' + a.id + '/schedule' : null;
			},
			body: function(a) { return a.body != null ? a.body : {}; }
		});
	},

	logs: function(req) {
		let limit = req.args != null ? +req.args.limit : 200;
		if (!(limit > 0))
			limit = 200;
		if (limit > 500)
			limit = 500;
		return call(req, {
			method: 'GET',
			path: function() { return '/api/logs?limit=' + limit; }
		});
	},

	send_code: function(req) {
		return call(req, {
			method: 'POST',
			path: function() { return '/api/send-code'; },
			body: function(a) { return a.body != null ? a.body : {}; }
		});
	}
};
